{
    "name": "Python & AI Development Container",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "python_app",
    "workspaceFolder": "/app",
    "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash"
    },
    "extensions": [
        "ms-python.python",
        "ms-python.pylint",
        "ms-python.black-formatter",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "bradlc.vscode-tailwindcss"
    ],
    "forwardPorts": [
        8000,
        11434,
        8001
    ],
    "runArgs": [],
    "remoteUser": "root",
    "postCreateCommand": "pip install --upgrade pip && pip install requests chromadb langchain langchain-community",
    "customizations": {
        "vscode": {
            "settings": {
                "python.linting.enabled": true,
                "python.linting.pylintEnabled": true,
                "python.formatting.provider": "black"
            }
        }
    },
    "initializeCommand": "docker compose up -d chromadb && sleep 30",
    "onCreateCommand": "echo 'Waiting for ChromaDB...' && sleep 10"
}